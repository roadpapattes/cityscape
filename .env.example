# Exemple de configuration d'environnement pour CityScape (backend Django).
#
# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
#   cp .env.example .env
# Le vrai `.env` n'est JAMAIS committé (voir .gitignore).

# --- Django ---
# Clé secrète : générer une valeur aléatoire longue en production.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# DEBUG=True uniquement en dev/test. En prod : False (active HTTPS, HSTS, etc.).
DEBUG=False

# Hôtes autorisés et origines CSRF de confiance (listes séparées par des virgules).
ALLOWED_HOSTS=api.cityscape.ovh,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.cityscape.ovh

# --- Base de données ---
# Laisser DB_ENGINE vide (ou commenté) => SQLite (dev/test).
# Mettre DB_ENGINE=postgres pour basculer sur PostgreSQL. Rollback = recommenter.
#DB_ENGINE=postgres
DB_NAME=cityscape
DB_USER=cityscape
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Durée (s) de réutilisation des connexions persistantes (0 = désactivé).
DB_CONN_MAX_AGE=60

# --- Email (Gmail SMTP) ---
# EMAIL_HOST_PASSWORD = "mot de passe d'application" Google (A2F requise).
EMAIL_HOST_USER=feedback.enigmapolis@gmail.com
EMAIL_HOST_PASSWORD=change-me-app-password

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com

# --- Chemins (surchargent les valeurs par défaut du settings) ---
#STATIC_ROOT=/var/www/cityscape/static
#MEDIA_ROOT=/var/www/cityscape/media
